# Copy this file to infrastructure/.env and replace every CHANGE_ME value.
# infrastructure/.env is ignored by Git and must never be committed.

SQLSERVER_SA_PASSWORD=CHANGE_ME_SQLSERVER_PASSWORD
SQLSERVER_PORT=1433

API_PORT=8080
WEB_PORT=5173

# Generate strong local-only values. Never commit the real values.
JWT_SIGNING_KEY=CHANGE_ME_AT_LEAST_32_RANDOM_BYTES
AUTH_BOOTSTRAP_ADMIN_EMAIL=admin@example.test
AUTH_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD

REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_PORT=6379

RABBITMQ_USER=ecp_app
RABBITMQ_PASSWORD=CHANGE_ME_RABBITMQ_PASSWORD
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

POSTGRES_DWH_DATABASE=english_center_dwh
POSTGRES_DWH_USER=ecp_dwh
POSTGRES_DWH_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
POSTGRES_DWH_PORT=5432

MINIO_ROOT_USER=ecp_minio
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_PASSWORD
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
