{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Jwt": {
    "Issuer": "EnglishCenter.Api",
    "Audience": "EnglishCenter.Web",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Messaging": {
    "RabbitMq": {
      "Enabled": false,
      "HostName": "localhost",
      "Port": 5672,
      "VirtualHost": "/",
      "ClientProvidedName": "english-center-api"
    }
  },
  "Cache": {
    "Redis": {
      "Enabled": false,
      "InstanceName": "english-center:",
      "DefaultTtlSeconds": 300,
      "CourseListTtlSeconds": 60
    }
  },
  "AllowedHosts": "*"
}
